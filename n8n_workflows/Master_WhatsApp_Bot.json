    {
      "parameters": {
        "jsCode": "\n// 1. Get Customer Coordinates\nlet custLat = 0, custLng = 0;\nconst norm = $('Normalize Payload').item.json;\nconst cust = $('Get Customer').item?.json?.fields;\n\nif (norm.lat && norm.lng) {\n  custLat = parseFloat(norm.lat);\n  custLng = parseFloat(norm.lng);\n} else if (cust && cust.lat && cust.lng) {\n  custLat = parseFloat(cust.lat.doubleValue);\n  custLng = parseFloat(cust.lng.doubleValue);\n}\n\n// 2. Get Available Doctors List\nconst doctors = $('Get Doctors').item.json;\nif (!doctors || doctors.length === 0 || !doctors[0].document) {\n  return [{ json: { error: \"No doctors found\" } }];\n}\n\n// Haversine formula\nfunction getDistanceKm(lat1, lon1, lat2, lon2) {\n  const R = 6371; \n  const dLat = (lat2 - lat1) * Math.PI / 180;\n  const dLon = (lon2 - lon1) * Math.PI / 180; \n  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +\n            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * \n            Math.sin(dLon/2) * Math.sin(dLon/2); \n  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)); \n  return R * c;\n}\n\n// 3. Find Closest\nlet closestDoctor = null;\nlet shortestDistance = Infinity;\n\nfor (const doc of doctors) {\n  if (!doc.document) continue;\n  \n  const fields = doc.document.fields;\n  const docLat = fields.lat ? parseFloat(fields.lat.doubleValue || fields.lat.stringValue) : 0;\n  const docLng = fields.lng ? parseFloat(fields.lng.doubleValue || fields.lng.stringValue) : 0;\n  const phone = fields.phone ? fields.phone.stringValue : '';\n  \n  if (docLat !== 0 && docLng !== 0 && custLat !== 0 && custLng !== 0) {\n    const dist = getDistanceKm(custLat, custLng, docLat, docLng);\n    if (dist < shortestDistance) {\n      shortestDistance = dist;\n      closestDoctor = { phone: phone, distance: dist.toFixed(2) };\n    }\n  } else if (!closestDoctor) {\n    // Fallback to first doctor if no coordinates are available\n    closestDoctor = { phone: phone, distance: 0 };\n  }\n}\n\nif (!closestDoctor) {\n  return [{ json: { error: \"No valid doctors found\" } }];\n}\n\nreturn {\n  closest_doctor_phone: closestDoctor.phone,\n  distance_km: closestDoctor.distance\n};\n"
      },
