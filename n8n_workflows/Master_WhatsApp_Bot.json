        2200,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "const serviceStr = ($('Pricing Data').item.json.service || '1').toLowerCase();\nlet base_price = 500;\nif (serviceStr.includes('2') || serviceStr.includes('injection')) base_price = 300;\nelse if (serviceStr.includes('3') || serviceStr.includes('catheter')) base_price = 800;\nelse if (serviceStr.includes('4') || serviceStr.includes('nurse')) base_price = 1500;\nelse if (serviceStr.includes('5') || serviceStr.includes('physio')) base_price = 750;\n\nconst distance_m = $json.rows?.[0]?.elements?.[0]?.distance?.value || 0;\nconst distance_km = distance_m / 1000;\nconst rate_per_km = 15;\nconst travel_charge = Math.round(distance_km * rate_per_km);\nconst total = base_price + travel_charge;\n\nreturn { base_price, travel_charge, total, distance_km };"
      },
      "id": "P-3",
      "name": "Calculate Price",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
